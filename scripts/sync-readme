#!/usr/bin/env python3
"""Write `lean-refactor -h` into the fenced block README marks for it.

The usage text has one source, the binary.  A README that retypes it drifts from it, and the drift
is invisible until someone runs a command the README still documents.  Run after changing `usage`.
"""
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parent.parent
readme = root / "README.md"
BEGIN, END = "<!-- usage:begin -->", "<!-- usage:end -->"

usage = subprocess.run([root / ".lake/build/bin/lean-refactor", "-h"],
                       capture_output=True, text=True, check=True).stdout.rstrip("\n")
text = readme.read_text()
try:
    head, rest = text.split(BEGIN, 1)
    _, tail = rest.split(END, 1)
except ValueError:
    sys.exit(f"{readme} has no {BEGIN} … {END} block to write into")
readme.write_text(f"{head}{BEGIN}\n\n```text\n{usage}\n```\n\n{END}{tail}")
print(f"wrote {usage.count(chr(10)) + 1} lines of usage into {readme.name}")
