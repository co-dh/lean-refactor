#!/bin/sh
# lean-refactor — run the refactoring tool against the repository in the CURRENT directory.
#
# The tool is CWD-relative by design: it loads `.lake/build/lib/lean/<Module>.ilean` from the
# repository being edited and verifies edits with that repository's build, so this script must NOT
# cd into the tool's own root. It builds the tool there and comes back.
#
# `lake env` supplies the TARGET repository's LEAN_PATH (and the interpreter's LD_LIBRARY_PATH), which
# is what lets the tool import the headers of the files it edits. Target and tool must therefore be on
# the same toolchain; a mismatch shows up as an olean version error.
#
# `cap` bounds address space: belt to `claimElaboration`'s braces (LeanRefactor.lean), which catches
# the KNOWN way to accumulate Lean `Environment`s — looping over files in one process — but not a
# runaway that is not a file loop. See the measurements in scripts/cap. Its limit is `CAP_MEM_MB` from
# the environment, inherited by every build the tool starts, so a package that needs more sets it.
#
# Build on EVERY invocation, not just when the binary is missing: the workflow for a refactor the tool
# cannot yet express is "improve the tool, then use the new operation", and a stale binary makes that
# silently run the old code. A no-op lake resolve costs ~100 ms, once — `forkPerFile`'s children re-exec
# `IO.appPath`, not this script, so it does not multiply.
#
# `-C <dir>`, first, as in `git -C`: run against the lake package at <dir>. A nested package
# (`require parent from ".."`) has a `.lake` of its own, so the tool starts there to read its
# `.ilean`s and build its default targets; its index rows still go to the ONE database at the
# repository root, which the tool finds and locks itself (`Db.locate`, `Db.withIndexLock`).
root=$(dirname "$(dirname "$(readlink -f "$0")")")
if [ "$1" = -C ]; then
  [ $# -ge 2 ] || { echo "lean-refactor: -C needs a directory" >&2; exit 2; }
  cd "$2" || { echo "lean-refactor: -C $2: cannot enter that directory" >&2; exit 1; }
  shift 2
fi
[ -f lakefile.lean ] || [ -f lakefile.toml ] || {
  echo "lean-refactor: $(pwd) has no lakefile.lean or lakefile.toml; run from a lake package root or pass -C <dir>" >&2
  exit 1
}
(cd "$root" && ./scripts/cap lake build -q) || exit 1
exec "$root/scripts/cap" lake env "$root/.lake/build/bin/lean-refactor" "$@"
